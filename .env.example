# Echoes.exe — Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials.

# ==========================================
# Core Server Configuration
# ==========================================
PORT=5000
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-random-secure-secret-key

# ==========================================
# AI Provider Configuration
# Choose either 'groq' or 'ollama'
# ==========================================
AI_PROVIDER=groq

# Provider 1: Groq API (Hosted AI - Recommended for hosted demos)
# Get your free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Provider 2: Gemma via Ollama (Local AI - 100% Offline & Private)
# Install Ollama from https://ollama.ai and run: ollama run gemma3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# ==========================================
# Persistent Storage & Memory
# Choose 'local' (SQLite) or 'atlas' (MongoDB Atlas)
# ==========================================
STORAGE_MODE=local

# MongoDB Atlas (Required only when STORAGE_MODE=atlas)
# Standard connection string from MongoDB Atlas cluster
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=echoes_vault

# ==========================================
# Optional External Research (SerpApi)
# Used for official documentation, CVE advisories, and migration guides
# ==========================================
SERPAPI_API_KEY=

# ==========================================
# Observability & Tracing (Sentry)
# Integrates error tracking and execution stage tracing
# ==========================================
SENTRY_DSN=

# ==========================================
# Voice Narration (ElevenLabs)
# Optional audio narration for "The Last Transmission"
# ==========================================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
